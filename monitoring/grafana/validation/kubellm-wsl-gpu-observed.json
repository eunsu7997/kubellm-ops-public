{
  "id": null,
  "uid": "kubellm-wsl-gpu-observed",
  "title": "KubeLLM-Ops WSL GPU — Observed Validation",
  "description": "Gateway metrics and vLLM names observed in saved Docker evidence. Isolated samples do not verify complete time series or benchmark performance. Kubernetes GPU and DCGM remain NOT VERIFIED. Source changes have not been deployed.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "kubellm-ops"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API Request Rate (VERIFIED metric name)",
      "description": "gateway_requests_total은 gateway/app/metrics.py에 정의된 실제 metric.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total[5m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error Rate (VERIFIED metric name)",
      "description": "gateway_requests_error_total (status 라벨별).",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_error_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "P95 Latency - Gateway (VERIFIED metric name)",
      "description": "gateway_request_latency_seconds histogram.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gateway_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Backend Failures by Reason (VERIFIED metric name)",
      "description": "gateway_backend_failures_total{reason=...} — connection_error/timeout/backend_5xx/http_error.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_backend_failures_total[5m])) by (reason)",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "vLLM TTFT p95 (observed in WSL k3s vLLM 0.30.0)",
      "description": "Observed Docker vLLM 0.30.0 histogram; tiny-sample p95 is a bucket estimate, not a benchmark.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:time_to_first_token_seconds_bucket[5m])) by (le))",
          "legendFormat": "TTFT p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "vLLM TPOT p95 (observed in WSL k3s vLLM 0.30.0)",
      "description": "Observed Docker vLLM 0.30.0 histogram; tiny-sample p95 is a bucket estimate, not a benchmark.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:request_time_per_output_token_seconds_bucket[5m])) by (le))",
          "legendFormat": "TPOT p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "vLLM Throughput - generation tokens/sec (observed in WSL k3s vLLM 0.30.0)",
      "description": "vllm:generation_tokens_total",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(vllm:generation_tokens_total[5m]))",
          "legendFormat": "tokens/sec"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "vLLM Queue / Waiting Requests (observed in WSL k3s vLLM 0.30.0)",
      "description": "Observed gauges vllm:num_requests_waiting and vllm:num_requests_running were 0 at idle. Queue behavior under load is NOT VERIFIED; keep engine/model labels when inspecting series.",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "vllm:num_requests_waiting",
          "legendFormat": "waiting"
        },
        {
          "expr": "vllm:num_requests_running",
          "legendFormat": "running"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "vLLM KV Cache Usage % (observed in WSL k3s vLLM 0.30.0)",
      "description": "Saved HELP defines 1 as 100 percent, so multiply by 100 for Grafana percent units. Observed idle value 0; utilization under load is NOT VERIFIED. This is KV cache occupancy, not total GPU memory usage.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "vllm:kv_cache_usage_perc * 100",
          "legendFormat": "kv cache %"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "GPU Utilization % (observed DCGM / WSL)",
      "description": "DCGM_FI_DEV_GPU_UTIL",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GPU Memory Used (observed DCGM / WSL)",
      "description": "DCGM_FI_DEV_FB_USED",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "GPU Temperature (observed DCGM / WSL)",
      "description": "DCGM_FI_DEV_GPU_TEMP",
      "gridPos": {
        "x": 12,
