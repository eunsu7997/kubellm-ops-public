{
  "id": null,
  "uid": "kubellm-ops",
  "title": "KubeLLM-Ops",
  "description": "Gateway metrics and vLLM names observed in saved Docker evidence. Isolated samples do not verify complete time series or benchmark performance. Kubernetes GPU and DCGM remain NOT VERIFIED. Source changes have not been deployed.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "tags": ["kubellm-ops"],
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "API Request Rate (VERIFIED metric name)",
      "description": "gateway_requests_total은 gateway/app/metrics.py에 정의된 실제 metric.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(gateway_requests_total[5m]))", "legendFormat": "requests/sec" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Error Rate (VERIFIED metric name)",
      "description": "gateway_requests_error_total (status 라벨별).",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(gateway_requests_error_total[5m])) by (status)", "legendFormat": "{{status}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "P95 Latency - Gateway (VERIFIED metric name)",
      "description": "gateway_request_latency_seconds histogram.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(gateway_request_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Backend Failures by Reason (VERIFIED metric name)",
      "description": "gateway_backend_failures_total{reason=...} — connection_error/timeout/backend_5xx/http_error.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(gateway_backend_failures_total[5m])) by (reason)", "legendFormat": "{{reason}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "vLLM TTFT p95 (observed in Docker vLLM 0.30.0)",
      "description": "Observed Docker vLLM 0.30.0 histogram; tiny-sample p95 is a bucket estimate, not a benchmark.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(vllm:time_to_first_token_seconds_bucket[5m])) by (le))", "legendFormat": "TTFT p95" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "vLLM TPOT p95 (observed in Docker vLLM 0.30.0)",
      "description": "Observed Docker vLLM 0.30.0 histogram; tiny-sample p95 is a bucket estimate, not a benchmark.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(vllm:request_time_per_output_token_seconds_bucket[5m])) by (le))", "legendFormat": "TPOT p95" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "vLLM Throughput - generation tokens/sec (observed in Docker vLLM 0.30.0)",
      "description": "vllm:generation_tokens_total",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(vllm:generation_tokens_total[5m]))", "legendFormat": "tokens/sec" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "vLLM Queue / Waiting Requests (observed in Docker vLLM 0.30.0)",
      "description": "Observed gauges vllm:num_requests_waiting and vllm:num_requests_running were 0 at idle. Queue behavior under load is NOT VERIFIED; keep engine/model labels when inspecting series.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "vllm:num_requests_waiting", "legendFormat": "waiting" },
        { "expr": "vllm:num_requests_running", "legendFormat": "running" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "vLLM KV Cache Usage % (observed in Docker vLLM 0.30.0)",
      "description": "Saved HELP defines 1 as 100 percent, so multiply by 100 for Grafana percent units. Observed idle value 0; utilization under load is NOT VERIFIED. This is KV cache occupancy, not total GPU memory usage.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [{ "expr": "vllm:kv_cache_usage_perc * 100", "legendFormat": "kv cache %" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "K8s Pod Ready (NOT VERIFIED - requires kube-state-metrics)",
      "description": "kube_pod_status_ready{namespace=\"kubellm-ops\"}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(kube_pod_status_ready{namespace=\"kubellm-ops\", condition=\"true\"}) by (pod)", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 11, "type": "timeseries", "title": "K8s Pod Restart Count (NOT VERIFIED - requires kube-state-metrics)",
      "description": "kube_pod_container_status_restarts_total{namespace=\"kubellm-ops\"}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"kubellm-ops\"}) by (pod)", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 12, "type": "timeseries", "title": "GPU Utilization % (NOT VERIFIED - requires DCGM Exporter)",
      "description": "DCGM_FI_DEV_GPU_UTIL",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [{ "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}}" }]
    },
    {
      "id": 13, "type": "timeseries", "title": "GPU Memory Used (MiB) (NOT VERIFIED - requires DCGM Exporter)",
      "description": "DCGM_FI_DEV_FB_USED",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "DCGM_FI_DEV_FB_USED", "legendFormat": "GPU {{gpu}}" }]
    },
    {
      "id": 14, "type": "timeseries", "title": "GPU Temperature (C) (NOT VERIFIED - requires DCGM Exporter)",
      "description": "DCGM_FI_DEV_GPU_TEMP",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "celsius" }, "overrides": [] },
      "targets": [{ "expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "GPU {{gpu}}" }]
    },
    {
      "id": 15, "type": "timeseries", "title": "GPU Power Usage (W) (NOT VERIFIED - requires DCGM Exporter)",
      "description": "DCGM_FI_DEV_POWER_USAGE",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "watt" }, "overrides": [] },
      "targets": [{ "expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "GPU {{gpu}}" }]
    }
  ]
}
